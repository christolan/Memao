<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User supplied LAN servers may use HTTP. HTTPS keeps system trust. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
